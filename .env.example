# ==========================================================
# Variáveis de Ambiente - Sabores da Serra
# ==========================================================
# INSTRUÇÕES DE USO:
#
# 1. AMBIENTE LOCAL (Desenvolvimento):
#    Copie este arquivo para .env na raiz do projeto:
#    No terminal: copy .env.example .env (Windows) ou cp .env.example .env (Linux/Mac)
#    O arquivo .env já está no .gitignore e nunca será enviado ao GitHub/Vercel.
#
# 2. AMBIENTE DE PRODUÇÃO (Vercel):
#    Acesse o painel do seu projeto na Vercel:
#    Project Settings > Environment Variables
#    Adicione a variável SECRET_KEY com um valor gerado de forma segura.
#
# COMO GERAR UMA CHAVE SEGURA:
# Execute no terminal:
# python -c "import secrets; print(secrets.token_hex(32))"
# ==========================================================

# Chave secreta de segurança (usada pelo Flask para assinar cookies e proteger sessões)
SECRET_KEY=sua_chave_secreta_aqui_gerada_com_secrets_token_hex

# Ambiente de execução ('development' para máquina local, 'production' na Vercel)
FLASK_ENV=development

# Modo Debug (True apenas em desenvolvimento local)
FLASK_DEBUG=True

# Porta de execução local (padrão: 5000)
PORT=5000
